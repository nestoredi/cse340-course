<%- include('partials/header') %>
<main id="main-content">
    <h1><%= title %></h1>

    <section class="detail detail-stacked">
        <h2><%= project.title %></h2>
        <p><%= project.description %></p>
        <ul class="detail-list">
            <li><strong>Date:</strong> <%= project.date %></li>
            <li><strong>Location:</strong> <%= project.location %></li>
            <li><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></li>
        </ul>

        <h3>Categories</h3>
        <% if (categories.length > 0) { %>
            <ul class="tag-list">
                <% categories.forEach(category => { %>
                    <li><a class="tag" href="/category/<%= category.category_id %>"><%= category.name %></a></li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>This project has no categories yet.</p>
        <% } %>

        <p class="action-row">
            <a class="button" href="/edit-project/<%= project.project_id %>">Edit Project</a>
            <a class="button" href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
            <a class="button button-secondary" href="/projects">Back to upcoming projects</a>
        </p>
    </section>
</main>
<%- include('partials/footer') %>
