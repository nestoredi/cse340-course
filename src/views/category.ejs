<%- include('partials/header') %>
<main id="main-content">
    <h1><%= title %></h1>

    <section class="detail detail-stacked">
        <h2><%= categoryDetails.name %></h2>
    </section>

    <h3>Service Projects</h3>
    <% if (projects.length === 0) { %>
        <p>There are no service projects in this category yet.</p>
    <% } else { %>
        <ul class="detail-list">
            <% projects.forEach(project => { %>
                <li>
                    <%= project.date %>:
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
                </li>
            <% }); %>
        </ul>
    <% } %>

    <p><a class="button button-secondary" href="/categories">Back to all categories</a></p>
</main>
<%- include('partials/footer') %>
