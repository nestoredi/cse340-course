<%- include('partials/header') %>
<main id="main-content">
    <h1><%= title %></h1>

    <section class="detail">
        <img class="detail-logo" src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
        <div>
            <h2><%= organizationDetails.name %></h2>
            <p>Description: <%= organizationDetails.description %></p>
            <p>Contact: <%= organizationDetails.contact_email %></p>
            <p><a class="button button-secondary" href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a></p>
        </div>
    </section>

    <h3>Service Projects</h3>
    <% if (projects.length === 0) { %>
        <p>This organization has no service projects yet.</p>
    <% } else { %>
        <ul class="detail-list">
            <% projects.forEach(project => { %>
                <li><%= project.date %>: <a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
            <% }); %>
        </ul>
    <% } %>

    <p><a class="button button-secondary" href="/organizations">Back to all organizations</a></p>
</main>
<%- include('partials/footer') %>
