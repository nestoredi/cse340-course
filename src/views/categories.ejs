<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>

    <p>Browse service projects by the kind of impact they make:</p>
    <ul class="card-list">
        <% categories.forEach(category => { %>
            <li class="card">
                <div><strong><a class="card-link" href="/category/<%= category.category_id %>"><%= category.name %></a></strong></div>
            </li>
        <% }); %>
    </ul>

    <p class="action-links"><a class="button" href="/new-category">Add a new category</a></p>
</main>

<%- include('partials/footer') %>
